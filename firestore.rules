rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regra padrão: negar tudo que não estiver explicitamente permitido abaixo.
    // Garante que nenhuma coleção seja pública acidentalmente.
    match /{document=**} {
      allow read, write: if false;
    }

    // Regras exclusivas para os dados dos usuários.
    // A estrutura do banco deve ser: usuarios/{uid}/<subcolecoes>
    match /usuarios/{uid}/{document=**} {
      
      // Permitir leitura e escrita apenas se o usuário estiver autenticado (request.auth != null)
      // E se o UID do usuário autenticado for exatamente igual ao ID do documento 'uid' sendo acessado.
      allow read, write: if request.auth != null && request.auth.uid == uid;
      
    }
  }
}
