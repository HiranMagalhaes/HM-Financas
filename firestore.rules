rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regra padrão: negar tudo que não estiver explicitamente permitido abaixo.
    // Garante que nenhuma coleção seja pública acidentalmente.
    match /{document=**} {
      allow read, write: if false;
    }

    // Regras exclusivas para os dados dos usuários.
    // A estrutura do banco deve ser: usuarios/{uid}/<subcoleções>
    //
    // Coleções atualmente em uso:
    //   - patrimonio/resumo          → resumo consolidado (Módulo 4)
    //   - hmcred/configuracao        → capital base do HMCRED (Módulo 5)
    //   - hmcred_operacoes/{id}      → operações de crédito (Módulo 5)
    //   - dinheiro/configuracao      → saldo total consolidado (Módulo 6A)
    //   - dinheiro_contas/{id}       → cada conta bancária/caixa (Módulo 6A)
    //   - cartoes/configuracao       → totais de limite e fatura (Módulo 6B)
    //   - cartoes_lista/{id}         → cada cartão de crédito (Módulo 6B)
    //   - cartoes_compras/{id}       → compras parceladas com baixa individual (Módulo 6B)
    //   - clientes/{id}              → cadastro de clientes/devedores (Módulo 7)
    //   - cobrancas/{id}             → cobranças vinculadas aos clientes (Módulo 7)
    //   - configuracoes/preferencias → preferências do usuário como tema (Módulo 10)
    //
    // A regra {document=**} usa wildcard recursivo e cobre TODAS as subcoleções
    // acima de forma automática. Não é necessário declarar cada uma separadamente.
    match /usuarios/{uid}/{document=**} {
      
      // Permitir leitura e escrita SOMENTE se:
      //   1. O usuário estiver autenticado (request.auth != null)
      //   2. O UID autenticado for exatamente igual ao UID do documento acessado
      // Isso garante que cada usuário só acessa seus próprios dados.
      allow read, write: if request.auth != null && request.auth.uid == uid;
      
    }
  }
}
